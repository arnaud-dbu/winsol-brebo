APP_NAME=Statamic
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=nl
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

GTM_CONTAINER_ID=

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=file

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
#CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

STATAMIC_LICENSE_KEY=
STATAMIC_PRO_ENABLED=true
STATAMIC_STACHE_WATCHER=auto
# Static caching: null (off) locally, "half" on production. See docs/static-caching.md
STATAMIC_STATIC_CACHING_STRATEGY=null
STATAMIC_REVISIONS_ENABLED=false
STATAMIC_GRAPHQL_ENABLED=false
STATAMIC_API_ENABLED=false
STATAMIC_GIT_ENABLED=false

RECAPTCHA_V3_SITE_KEY=
RECAPTCHA_API_KEY=
RECAPTCHA_PROJECT_ID=
RECAPTCHA_V3_THRESHOLD=.5

DEBUGBAR_ENABLED=false

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_URL=
R2_ENDPOINT=
R2_ROOT=

# Schijf achter de `r2_private`-container (offerte-uploads). Beide vallen
# terug op een default (R2_BUCKET resp. de letterlijke waarde "private"),
# dus onbeheerd laten staan is veilig. Er is bewust GEEN R2_PRIVATE_URL:
# de afwezigheid van een `url`-sleutel in config/filesystems.php is wat
# Statamic de container als privé laat behandelen — niet toevoegen.
R2_PRIVATE_BUCKET=
R2_PRIVATE_ROOT=

# Zet op "glide" om Glide-afgeleiden naar R2 te schrijven en direct
# vanaf R2/CDN te serveren. Vereist dat alle R2_*-waarden hierboven
# ingevuld zijn. Eerste render per afbeelding is trager (synchrone
# generatie); daarna serveert Cloudflare alles. Na het aanzetten
# eenmalig `php please static:clear` draaien.
GLIDE_CACHE=
